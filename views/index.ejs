<!DOCTYPE html>
<html lang="en">
  <%- include('partials/header.ejs') %>
  <body>
    <%- include('partials/nav.ejs') %>
    <div class="page-container">
      <div class="search-input">
        <img id="cart-icon" src="/cart.svg" alt="cart"/>
        <h2><%= title %></h2>
        <form action="/new" method="get">
            <button id="new-item-submit-btn" type="submit">
              <img src="/add_white.svg" alt="add item"/>
              Add Item</button>
        </form>
        <form id="search-form" action="/search" method="get">
          <label for="search"></label>
          <input type="text" name="search" id="search"
          <% if (searchString !== '') { %>
            value="<%= searchString %>" autofocus
          <% } else { %> 
            placeholder="Search items..."
          <% } %>
          />
        </form>
      </div>
      <div class="inventory-container">
        <% if (items && items.length > 0) { %>
          <% items.forEach(item => {  %>
            <div class="item-container">
              <img src="<%= item.img_url || '/no-image.png'%>" alt="<%= item.item_name %>"/>
              <div class="item-name"><%= item.item_name %></div>
              <div class="item-quantity"><%= item.quantity_in_stock %> in stock</div>
              <div class="item-brand"><%= item.brand_name ?? 'no-brand'%></div>
              <% if (item.categories && item.categories.length > 0) { %>
                <% item.categories.forEach(category => {  %>
                  <span class="item-category"><%= category.name %></span>
                <% }) %>
              <% } %>
              <div class="item-price"><%= item.price %></div>
              <div class="item-disc-price"><%= item.discounted_price %>
                <% if(item.discounted_price && item.discounted_price > 0) { %>
                  <span class="item-disc-percent-off">
                    (<%= calculatePercentOff(item.discounted_price, item.price) %>% off)
                  </span>
                <% } %>
              </div>
              <form action="<%= item.item_no %>/edit" method="GET">
                <button class="edit-btn" type="submit">Edit</button>
              </form>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
    <script src="/searchFilter.js"></script>
  </body>
</html>
