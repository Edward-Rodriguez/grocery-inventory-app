<!doctype html>
<html lang="en">
  <%- include('partials/header.ejs') %>
  <body>
    <div id="mng-brands-container">
      <h1>Manage Brands</h1>
      <div class="quantity-label"><%= brands.length %> brands's</div>
      <form id="add-new-btn-form" action="new" method="GET">
        <button type="submit">
          <img class="mng-icon" src="/add-new.svg" alt="add new" />
          Add New
        </button>
      </form>
      <% if (brands && brands.length > 0) { %>
        <div id="brand-list">
          <% brands.forEach(brand => { %>
            <div class="brand">
              <h2><%= brand.name %></h2>
              <p><%= brand.productCount %> products</p>
              <form
                action="<%= brand.id %>/delete"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this brand?');">
                <button id="delete-brand-btn" type="submit">
                  <img src="/close.svg" alt="delete"/>
                </button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </body>
</html>
