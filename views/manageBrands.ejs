<!doctype html>
<html lang="en">
  <%- include('partials/header.ejs') %>
  <body>
    <div id="mng-brands-container">
      <h1>Manage Brands</h1>
       <span class="quantity-label"><%= brands.length %> brands's</span>
      <div id="page-description">Add, view, and manage your inventory brands.</div>
      <form id="add-new-btn-form" action="new" method="POST">
        <label for="brand">Add new brand</label>
        <input type="text" name="brand" id="brand" placeholder="Enter brand name..." required/>
        <button type="submit">
          <img class="mng-icon" src="/add-new.svg" alt="add new" />
          Add
        </button>
      </form>
      <% if (brands && brands.length > 0) { %>
        <div id="brand-list">
          <% brands.forEach(brand => { %>
            <div class="brand">
              <h2><%= brand.name %></h2>
              <p><%= brand.productCount %> products</p>
              <form
                action="<%= brand.id %>/delete"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this brand?\n*Note: Items under this brand will not be removed, only the brand itself.');">
                <button class="delete-entity-btn" type="submit">
                  <!-- <img class="delete-icon" src="/delete.svg" alt="delete"/> -->
                </button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </body>
</html>
