<!DOCTYPE html>
<html lang="en">
<%- include('partials/header.ejs') %>

  <body>
    <%- include('partials/nav.ejs') %>
      <form id="edit-form" method="POST"
        action="<%= newProduct ? '/new' : '/'+ item.item_no + '/update'%>">
        <%- include("partials/errors.ejs") %>
          <div class="product-information">
            <h3>Product Information</h3>
            <div id="product-info-main">
              <img id="image-preview" src="<%= item?.img_url || '/no-image.png'%>"
                alt="<%= item?.name ?? '' %>" />
              <div id="product-info-input">
                <label for="item_name">Name</label>
                <input type="text" name="item_name" id="item_name"
                  value="<%= item?.name ?? '' %>" placeholder="Enter item name" required />
                <label for="brandSelect">Brand</label>
                <select name="brand" id="brandSelect" required>
                  <option value="">--Please choose a brand--</option>
                  <% if (brands && brands.length> 0 ) { %>
                    <% brands.forEach(brand=> { %>
                      <option value="<%= brand.id %>" <% if(item.brand_id===brand.id) {
                        %> selected <% } %>><%= brand.name %>
                      </option>
                    <% }); %>
                  <% } %>
                </select>
                <a class="manage-link" href="/brands/manage">
                  <div class="manage-link-container" title="Add/Remove brands">
                    <img src="/settings_gray.svg" alt="manage brands" />
                    Manage Brands
                  </div>
                </a>
              </div>
            </div>
            <p id="img-load-error"></p>
            <label for="imageUrl">Image URL</label>
            <div>
              <input type="url" name="imageUrl" id="imageUrl"
                value="<%= item?.img_url %>" />
              <button id="apply-img-btn" type="button">Update Preview</button>
            </div>
          </div>
          <div class="categories">
            <h2>Categories</h2>
            <p>Choose applicable categories.</p>
            <div class="category-checkboxes">
              <% if (categories && categories.length> 0) { %>
                <% categories.forEach(category=> { %>
                  <label class="category-option">
                    <input type="checkbox" name="categories" value="<%= category.id %>"
                      <% if (item.categories && item.categories.some((itemCategory)=>
                      itemCategory.id === category.id)) { %> checked <% } %> />
                      <p>
                        <%= category.name %>
                      </p>
                  </label>
                <% }) %>
              <% } %>
            </div>
            <a class="manage-link" href="/categories/manage">
            <div class="manage-link-container" title="Add/Remove categories">
              <img src="/settings_gray.svg" alt="manage categories" />
              Manage Categories
            </div>
          </a>
          </div>
          <div id="inventory-pricing">
            <h2>Inventory & Pricing</h2>
            <label for="quantity_in_stock">Quantity In Stock</label>
            <input type="number" name="quantity_in_stock" min="0" inputmode="numeric"
              id="quantity_in_stock" value="<%= item.quantity_in_stock ?? 0 %>"
              required />
            <label for="price">Regular Price</label>
            <span class="currencyInput" id="priceSpan">
              <img class="mng-icon" src="/dollar_sign.svg" alt="" />
              <input type="number" step="any" name="price" min="0" inputmode="decimal"
                id="price" value="<%= item.price ?? '' %>" required />
            </span>
            <label for="discounted_price">Discount Price</label>
            <span class="currencyInput" id="discPriceSpan">
              <img class="mng-icon" src="/dollar_sign.svg" alt="" />
              <input type="number" step="any" name="discounted_price" min="0"
                inputmode="decimal" id="discounted_price"
                value="<%= item.discounted_price ?? '' %>" />
            </span>
          </div>
          <button id="submit-edit-btn" type="submit">Save Changes</button>
          <a id="cancel" href="/">Cancel</a>
      </form>
      <form id="delete-item-form" action="/<%= item.item_no %>/delete" method="POST"
        onsubmit="return confirm('Are you sure you want to delete this item?')">
        <div>Danger Zone</div>
        <p>Permanently delete this product from your inventory.</p>
        <button id="delete-item-btn" type="submit">Delete Item</button>
      </form>
      <script src="/imagePreview.js"></script>
  </body>
</html>