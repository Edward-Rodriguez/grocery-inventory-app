<!DOCTYPE html>
<html lang="en">
  <%- include('partials/header.ejs') %>
  <body>
    <h1><%= title %></h1>
    <form id="edit-form" action="<% item.item_no %>/edit" method="POST">
      <img
        id="image-preview"
        src="<%= item.img_url || '/no-image.png'%>"
        alt="<%= item.item_name %>" />
      <p id="img-load-error"></p>
      <label for="image-url">Image URL:</label>
      <input type="url" name="image-url" id="image-url" />
      <button id="apply-img-btn" type="button">Apply</button>
      <label for="item_name">Name:</label>
      <input
        type="text"
        name="item_name"
        id="item_name"
        value="<%= item.name ?? '' %>"
        required />
      <label for="brand-select">Brand:</label>
      <select name="brand" id="brand-select">
        <option value="">--Please choose a brand--</option>
        <% if (brands && brands.length > 0 ) { %>
            <% brands.forEach(brand => { %>
                <option value="<%= brand.id %>">
                    <img class="mng-icon" src="/settings_gray.svg" alt=""/>
                    <%= brand.name %>
                </option>
            <% }); %>
        <% } %>
      </select>
      <a id="manage-link" href="/brands/manage">Manage Brands</a>
      <fieldset class="categories">
        <legend>Categories</legend>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(category => { %>
                <label class="category-option">
                    <input type="checkbox" name="categories" value="<%= category.id %>"  
                    <% if (item.categories.some((itemCategory) => 
                        itemCategory.id === category.id)) { %> 
                        checked 
                    <% } %> /> 
                    <p><%= category.name %></p>
                </label>
            <% }) %>
        <% } %>  
      </fieldset> 
      </select>
      <a id="manage-link" href="/categories/manage">Manage Categories</a>
    </form>
    <script src="/imagePreview.js"></script>
  </body>
</html>
