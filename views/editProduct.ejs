<!DOCTYPE html>
<html lang="en">
  <%- include('partials/header.ejs') %>
  <body>
    <h1><%= title %></h1>
    <form action="<% item.item_no %>/edit" method="POST">
      <img
        id="image-preview"
        src="<%= item.img_url || '/no-image.png'%>"
        alt="<%= item.item_name %>" />
      <label for="image-url">Image URL:</label>
      <input type="url" name="image-url" id="image-url" />
      <button id="apply-img-btn" type="button">Apply</button>
    </form>

    <script>
      function previewImage() {
        const newImageUrl = document.querySelector('#image-url').value.trim();
        const imagePreview = document.querySelector('#image-preview');
        imagePreview.src = newImageUrl;
      }

      document
        .querySelector('#apply-img-btn')
        .addEventListener('click', previewImage);
    </script>
  </body>
</html>
